# ─────────────────────────────────────────────────────────────────────────────
# Iqtadi prayer backend — environment template
#
# Copy this file to `backend/.env` before running. Variable names must match
# the `Settings` fields in `app/config.py` exactly (Pydantic resolves each
# field to the uppercase env var of the same name — there is no prefix).
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Host/port uvicorn binds to inside the backend container.
HOST=0.0.0.0
PORT=8000
# Log level: DEBUG | INFO | WARNING | ERROR. DEBUG also enables /docs.
LOG_LEVEL=INFO

# ── Prayer guidance LLM (DeepSeek) ───────────────────────────────────────────
# The backend uses the official `openai` async client, so any
# OpenAI-compatible endpoint works (vLLM, Ollama, Together, …).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=changeme
# The API accepts exactly two model names: `deepseek-flash` and
# `deepseek-v4-pro`. The retired alias `deepseek-chat` fails at request time.
DEEPSEEK_MODEL=deepseek-flash
# Hard cap on tokens per guidance reply. Guidance is one short Arabic sentence.
DEEPSEEK_MAX_TOKENS=160
# Sampling temperature. Ignored by the provider while thinking mode is on.
DEEPSEEK_TEMPERATURE=0.5
# Per-request timeout in seconds.
DEEPSEEK_TIMEOUT_S=20.0
# `deepseek-flash` enables thinking by default at effort=high, which would
# consume the entire token budget as chain-of-thought and can return an empty
# reply. Keep this false for short guidance cues.
DEEPSEEK_THINKING=false
# Kill switch: when false, guidance serves bundled static Arabic text and
# never touches the network.
PRAYER_GUIDANCE_ENABLED=true
# Recorded-video analysis (opt in only on a development server).
INFERENCE_PROVIDER=mock
ANALYSIS_ALLOW_MOCK=false
FRAME_SAMPLE_FPS=4
ANALYSIS_BATCH_FRAMES=8
ANALYSIS_MAX_FRAME_BYTES=200000
ANALYSIS_MAX_DIMENSION=960
ANALYSIS_MAX_REQUEST_BYTES=2500000
ANALYSIS_MAX_FRAMES=2400
ANALYSIS_MAX_DURATION_MS=1200000
ANALYSIS_MAX_JOBS=8
ANALYSIS_WORKERS=1
ANALYSIS_RETENTION_SECONDS=3600
ANALYSIS_STORAGE_DIR=data/prayer_analyses
TEMPORAL_CONFIDENCE=0.65
TEMPORAL_MIN_OBSERVATIONS=1
TEMPORAL_MIN_DURATION_MS=0
TEMPORAL_MAX_GAP_MS=1000
ANALYSIS_POSE_MAP={"standing":"standing","ruku":"ruku","sujood":"sujood","sitting":"sitting","unknown":"unknown"}
# Empty means loopback-only admin. Set a server-side token behind an auth gateway.
PRAYER_ADMIN_TOKEN=

# Local 33-landmark / 166-feature TorchScript prayer model bundle.
PRAYER_MODEL_BUNDLE_DIR=models/prayer_action

# Experimental corrections (independent opt-in; restart backend after changing).
PRAYER_MIRROR_SUJOOD_RECOVERY=false
PRAYER_RUKU_GEOMETRY_GATE=false
PRAYER_SEATED_PROBABILITY_PROJECTION=false
PRAYER_SEQUENCE_NORMALIZATION=false
PRAYER_RAKAH_TRANSITION_ANCHORS=false

# Mosque Companion demonstration only. No production identities or notifications.
MOSQUE_DEMO_ENABLED=false
MOSQUE_DEMO_DB=data/mosque_companion.sqlite3
MOSQUE_HOLD_MINUTES=5
MOSQUE_INVITATION_MINUTES=10
MOSQUE_INVITATION_BATCH=3

# Optional parent/teacher accounts — entirely on this FastAPI backend.
ACCOUNT_DB=data/accounts.sqlite3
ACCOUNT_PUBLIC_URL=https://your-backend.example.com
ACCOUNT_ALLOWED_ORIGINS=["https://your-flutter-web.example.com"]
ACCOUNT_SECURE_COOKIES=true
ACCOUNT_MAIL_MODE=smtp
ACCOUNT_MAIL_FROM=Iqtadi <no-reply@your-domain.example>
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USER=
ACCOUNT_SMTP_PASSWORD=
# Explicit local development only; .eml files must never be publicly served.
ACCOUNT_MAIL_OUTBOX=data/account_mail_outbox
