# ─────────────────────────────────────────────────────────────────────────────
# Real-Time AI Fitness Coaching — environment template
#
# Copy this file to `.env` before running docker compose. Every variable below
# has a sensible default for local development; override in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Host/port uvicorn binds to inside the backend container.
HOST=0.0.0.0
PORT=8000
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── LLM: Qwen2.5 via OpenAI-compatible API ───────────────────────────────────
# The backend uses the official `openai` async client. Any OpenAI-compatible
# endpoint works: Alibaba DashScope, Together AI, a local vLLM server, or
# Ollama (`http://host.docker.internal:11434/v1`).
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=changeme
QWEN_MODEL=qwen2.5-7b-instruct
# Hard cap on tokens per correction. Coaching replies should be short and punchy.
QWEN_MAX_TOKENS=60
# Sampling temperature. Keep low so the coach doesn't go off-script.
QWEN_TEMPERATURE=0.3

# ── TTS: pluggable provider ──────────────────────────────────────────────────
# `edge`       — Microsoft Edge-TTS, free, no key. Default.
# `elevenlabs` — ElevenLabs streaming API (requires ELEVENLABS_API_KEY).
TTS_PROVIDER=edge

# Voice identifier for the selected provider.
#  • Edge-TTS: e.g. en-US-GuyNeural, en-US-JennyNeural, en-GB-RyanNeural
#  • ElevenLabs: a voice_id from your account (e.g. 21m00Tcm4TlvDq8ikWAM)
TTS_VOICE=en-US-GuyNeural

# ElevenLabs only — safe to leave blank if TTS_PROVIDER=edge.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── Coaching behavior ────────────────────────────────────────────────────────
# Minimum seconds between two consecutive corrections for the *same* error.
# Prevents the coach from nagging on every frame when a fault persists.
COACHING_COOLDOWN_S=4.0
