<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude local prayer data from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="iqtadi-local/" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageEncryptedSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="iqtadi-local/" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageEncryptedSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
