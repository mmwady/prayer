# Model asset hashes cover exact bytes, including JSON line endings.
mobile/coaching/browser/assets/*.json -text whitespace=cr-at-eol
# The locked manifest also hashes pipeline sources and the npm lockfile.
mobile/coaching/browser/src/*.mjs text eol=lf
mobile/coaching/browser/scripts/mediapipe-presence.mjs text eol=lf
mobile/coaching/browser/package-lock.json text eol=lf
deploy/vps/*.sh text eol=lf
